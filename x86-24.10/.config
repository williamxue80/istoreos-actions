#
# iStoreOS 24.10 x86_64 J4025 ESXi Minimal Router
#

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y

CONFIG_GRUB_TIMEOUT="1"

CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=512


#
# Kernel
#

CONFIG_KERNEL_X86_MCE=y
CONFIG_KERNEL_SCHED_INFO=y
CONFIG_KERNEL_NET_CLS_CGROUP=y

CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_DEVICE=y

CONFIG_KERNEL_CRYPTO_AES=y
CONFIG_KERNEL_CRYPTO_CHACHA20=y


#
# ESXi
#

CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y


#
# Intel / Realtek NIC
#

CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-r8125=y


#
# Basic System
#

CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y

CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lscpu=y

CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y

CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y


#
# SSH
#

CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssh-sftp-server=y


#
# LuCI (去除 luci / luci-light 元包冗余，只保留精确的 mod 组合)
#

CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

CONFIG_PACKAGE_luci-ssl=y


#
# Theme
#

CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y


#
# Web
#

CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y


#
# Language
#

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y

#
# Network Core
#

CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_uci=y

CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libubus-lua=y


#
# DHCP / DNS
#

CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y


#
# Firewall (OpenWrt 24.10 nftables)
#

CONFIG_PACKAGE_firewall4=y

CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y

CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y


#
# Conntrack
#

CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

CONFIG_PACKAGE_kmod-nf-nat=y

CONFIG_PACKAGE_ipset=y


#
# Routing
#

CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ip-tiny=y

CONFIG_PACKAGE_route=y

CONFIG_PACKAGE_kmod-tun=y


#
# WireGuard
#

CONFIG_PACKAGE_kmod-wireguard=y

CONFIG_PACKAGE_wireguard-tools=y

CONFIG_PACKAGE_luci-proto-wireguard=y

CONFIG_PACKAGE_luci-app-wireguard=y


#
# WireGuard Crypto
#

CONFIG_PACKAGE_kmod-crypto-blake2b=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y


#
# DDNS
#

CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-services=y

CONFIG_PACKAGE_luci-app-ddns=y


#
# QoS / Network Tools
#

CONFIG_PACKAGE_tc=y

CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-cake=y

CONFIG_PACKAGE_mtr=y


#
# PassWall
#

CONFIG_PACKAGE_luci-app-passwall=y

CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y


#
# PassWall Dependencies
#

CONFIG_PACKAGE_ca-bundle=y

CONFIG_PACKAGE_libopenssl=y

CONFIG_PACKAGE_openssl-util=y

CONFIG_PACKAGE_libcurl=y

CONFIG_PACKAGE_libpthread=y

CONFIG_PACKAGE_libpcre2=y


#
# PassWall Helper Tools (分流/DNS/透明代理常用辅助包，非强制依赖需手动勾选)
#

CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_redsocks2=y


#
# Proxy Core
#

CONFIG_PACKAGE_xray-core=y

CONFIG_PACKAGE_sing-box=y


#
# Encryption Support
#

CONFIG_PACKAGE_libmbedtls=y

CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set


#
# Time Sync
#

CONFIG_PACKAGE_ntp-utils=y

CONFIG_PACKAGE_ntpdate=y


#
# Storage Basic
#

CONFIG_PACKAGE_block-mount=y

CONFIG_PACKAGE_lsblk=y

CONFIG_PACKAGE_fdisk=y


#
# USB Storage Filesystem Support (补全U盘/移动存储的识别与挂载能力)
#

CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y


#
# ZRAM
#

CONFIG_PACKAGE_zram-swap=y

#
# iStoreOS 24.10 x86_64 J4025 ESXi Minimal
# Part 3/3
#


#
# Hardware Monitor
#
# 说明: cpufrequtils / luci-app-cpufreq / lm-sensors / kmod-hwmon-core 已移除
# 原因: ESXi 虚拟机内无法获取真实 CPU 调频与硬件传感器数据，装了也基本无效，
#       属于精简目标下可去除的冗余包。若未来直接刷物理机可再加回。
#


#
# USB Basic Support
#

CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

CONFIG_PACKAGE_usbutils=y


#
# Virtualization Support
#

CONFIG_PACKAGE_kmod-vhost=y
CONFIG_PACKAGE_kmod-vhost-net=y


#
# Useful Tools
#

CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-pkill=y

CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_file=y

CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y


#
# Firewall UI
#

CONFIG_PACKAGE_luci-app-firewall=y


#
# UPnP (Optional Router Function)
#

CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y


#
# Wake On LAN
#

CONFIG_PACKAGE_luci-app-wol=y


#
# TTY Web Terminal
#

CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y


#
# Disable IPv6
#

# CONFIG_PACKAGE_ipv6helper is not set

# CONFIG_PACKAGE_luci-proto-ipv6 is not set


#
# Disable Docker
#

# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set


#
# Disable NAS
#

# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_samba4-libs is not set

# CONFIG_PACKAGE_nfs-kernel-server is not set
# CONFIG_PACKAGE_nfs-utils is not set


#
# Disable Wireless
#

# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-mt76 is not set
# CONFIG_PACKAGE_kmod-rtw88 is not set
# CONFIG_PACKAGE_kmod-rtw89 is not set


#
# Image Optimization
#

CONFIG_IMAGEOPT=y

CONFIG_CLEAN_IPKG=y

CONFIG_TARGET_IMAGES_GZIP=y


#
# Firmware Size
#

CONFIG_TARGET_ROOTFS_SQUASHFS=y


#
# Version
#

CONFIG_VERSIONOPT=y

CONFIG_VERSION_DIST="iStoreOS"

CONFIG_VERSION_REPO="https://mirrors.cernet.edu.cn/openwrt/releases/%V"


#
# Build
#

CONFIG_BUILD_PATENTED=y

CONFIG_USE_MKLIBS=y

CONFIG_STRIP_KERNEL_EXPORTS=y
